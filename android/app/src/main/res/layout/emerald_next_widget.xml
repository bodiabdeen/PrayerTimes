<?xml version="1.0" encoding="utf-8"?>
<!-- v2.0 Emerald "Next prayer" widget. Filled by EmeraldWidgets.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/em_next_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_emerald_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.12"
        android:text="NEXT PRAYER"
        android:textColor="#2BC48A"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/em_next_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:text="Dhuhr"
        android:textColor="#EAF4F1"
        android:textSize="24sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Begins"
                android:textColor="#93AAA6"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/em_next_apt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:30"
                android:textColor="#EAF4F1"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/em_next_mit_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Iqama"
                android:textColor="#93AAA6"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/em_next_mit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="13:15"
                android:textColor="#2BC48A"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- A FrameLayout, not a View: home screen widgets cannot use a plain View -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:background="#1D3D40" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/em_after1_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Asr"
            android:textColor="#93AAA6"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/em_after1_apt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14:18"
            android:textColor="#EAF4F1"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/em_after2_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Maghrib"
            android:textColor="#93AAA6"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/em_after2_apt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="16:43"
            android:textColor="#EAF4F1"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
