<?xml version="1.0" encoding="utf-8"?>
<!-- v2.0 Emerald "Prayer day" widget. Filled by EmeraldWidgets.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/em_day_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_emerald_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/em_day_fajr"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="2dp"
        android:layout_weight="1"
        android:background="@drawable/widget_emerald_cell"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="2dp">

        <TextView
            android:id="@+id/em_day_fajr_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Fajr"
            android:textColor="#93AAA6"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/em_day_fajr_apt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="06:09"
            android:textColor="#EAF4F1"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/em_day_fajr_mit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="06:30"
            android:textColor="#93AAA6"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
