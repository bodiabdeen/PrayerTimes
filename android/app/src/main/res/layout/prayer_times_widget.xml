<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Header -->
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Prayer Times"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:paddingBottom="4dp"/>

    <!-- Current Prayer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#30CAA55E"
        android:padding="6dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/current_prayer_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fajr"
            android:textColor="#CAA55E"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="2dp"/>

        <LinearLayout
            android:id="@+id/current_apt_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/current_apt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="06:30"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="end"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/current_mat_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/current_mat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="06:25"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="end"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/current_mit_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/current_mit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="06:30"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="end"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Next Prayer 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#15FFFFFF"
        android:padding="6dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/next1_prayer_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dhuhr"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="2dp"/>

        <LinearLayout
            android:id="@+id/next1_apt_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/next1_apt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="13:15"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:gravity="end"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/next1_mat_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/next1_mat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="13:20"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:gravity="end"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/next1_mit_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/next1_mit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="13:30"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:gravity="end"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Next Prayer 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#15FFFFFF"
        android:padding="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/next2_prayer_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Asr"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="2dp"/>

        <LinearLayout
            android:id="@+id/next2_apt_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/next2_apt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="15:45"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:gravity="end"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/next2_mat_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/next2_mat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="15:50"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:gravity="end"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/next2_mit_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/next2_mit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="16:00"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:gravity="end"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
