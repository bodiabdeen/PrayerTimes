# Disable New Architecture on iOS so the bridge registers RCTEventEmitter and
# react-native-safe-area-context works without hacks. Native patches (see scripts/patch-react-native.js)
# make the app use bridge + legacy RCTRootView when this is set.
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

use_frameworks! :linkage => :static


target 'JICPrayerTimes' do
  config = use_native_modules!
  
  # 👇 gRPC pods MUST be inside the target
  pod 'gRPC-Core', :modular_headers => true
  pod 'gRPC-C++', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    node_binary = ENV['NODE_BINARY'] || '/Users/abdulsamadkhan/.nvm/versions/node/v22.21.1/bin/node'

    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Ensure hermes-engine script phase has REACT_NATIVE_PATH (fixes: with-environment.sh: No such file or directory)
    react_native_path_value = File.join("${PODS_ROOT}", "..", config[:reactNativePath])
    installer.pods_project.targets.each do |target|
      if target.name == 'hermes-engine'
        target.build_configurations.each do |build_config|
          build_config.build_settings['REACT_NATIVE_PATH'] = react_native_path_value
          build_config.build_settings['NODE_BINARY'] = node_binary
        end
      end
    end

    # Xcode GUI shells often don't load nvm, causing script phases to fail.
    # Ensure script phases across pods can always invoke node.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['NODE_BINARY'] = node_binary
      end
    end

    # Fix gRPC template syntax issue with Xcode 16.2+
    # The issue is in basic_seq.h where CallSeqFactory is used as a template member
    # This file exists in multiple locations (main pod dirs + Headers dirs)
    basic_seq_paths = [
      File.join(installer.sandbox.root, 'gRPC-Core/src/core/lib/promise/detail/basic_seq.h'),
      File.join(installer.sandbox.root, 'gRPC-C++/src/core/lib/promise/detail/basic_seq.h'),
      File.join(installer.sandbox.root, 'Headers/Private/gRPC-Core/grpc/src/core/lib/promise/detail/basic_seq.h'),
      File.join(installer.sandbox.root, 'Headers/Private/gRPC-C++/grpcpp/src/core/lib/promise/detail/basic_seq.h')
    ]
    
    basic_seq_paths.each do |file_path|
      if File.exist?(file_path)
        system("chmod +w '#{file_path}'")
        content = File.read(file_path)
        # Replace "Traits::template CallSeqFactory" with "Traits::CallSeqFactory"
        fixed_content = content.gsub(
          'Traits::template CallSeqFactory',
          'Traits::CallSeqFactory'
        )
        if content != fixed_content
          File.write(file_path, fixed_content)
          puts "Patched #{file_path}"
        end
      end
    end
    
    # Fix BoringSSL-GRPC build issue with unsupported -G flag on iOS simulator
    # The -GCC_WARN_INHIBIT_ALL_WARNINGS flag is being interpreted as -G by newer clang versions
    installer.pods_project.targets.each do |target|
      if target.name == 'BoringSSL-GRPC'
        target.source_build_phase.files.each do |file|
          if file.settings && file.settings['COMPILER_FLAGS']
            flags = file.settings['COMPILER_FLAGS'].split
            flags.reject! { |flag| flag == '-GCC_WARN_INHIBIT_ALL_WARNINGS' }
            file.settings['COMPILER_FLAGS'] = flags.join(' ')
          end
        end
      end
    end

    # Work around Apple clang + fmt consteval failures on Xcode 16.x.
    # This keeps fmt runtime-safe while disabling compile-time format checks.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'fmt'

      target.build_configurations.each do |config|
        definitions = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
        definitions = [definitions] if definitions.is_a?(String)
        definitions << 'FMT_USE_CONSTEVAL=0' unless definitions.include?('FMT_USE_CONSTEVAL=0')
        definitions << 'FMT_USE_NONTYPE_TEMPLATE_ARGS=0' unless definitions.include?('FMT_USE_NONTYPE_TEMPLATE_ARGS=0')
        definitions << 'FMT_ENFORCE_COMPILE_STRING=0' unless definitions.include?('FMT_ENFORCE_COMPILE_STRING=0')
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = definitions

        cxxflags = config.build_settings['OTHER_CPLUSPLUSFLAGS'] || ['$(inherited)']
        cxxflags = [cxxflags] if cxxflags.is_a?(String)
        cxxflags << '-DFMT_USE_CONSTEVAL=0' unless cxxflags.include?('-DFMT_USE_CONSTEVAL=0')
        cxxflags << '-DFMT_USE_NONTYPE_TEMPLATE_ARGS=0' unless cxxflags.include?('-DFMT_USE_NONTYPE_TEMPLATE_ARGS=0')
        cxxflags << '-DFMT_ENFORCE_COMPILE_STRING=0' unless cxxflags.include?('-DFMT_ENFORCE_COMPILE_STRING=0')
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] = cxxflags
      end
    end

    # Patch fmt 11.0.2 internal FMT_STRING callsites that fail with Xcode 16.x
    # Apple clang consteval evaluation. Use runtime format strings instead.
    fmt_inl = File.join(installer.sandbox.root, 'fmt/include/fmt/format-inl.h')
    if File.exist?(fmt_inl)
      system("chmod +w '#{fmt_inl}'")
      content = File.read(fmt_inl)
      patched = content
        .gsub('fmt::format_to(it, FMT_STRING("{}{}"), message, SEP);',
              'fmt::format_to(it, fmt::runtime("{}{}"), message, SEP);')
        .gsub('fmt::format_to(it, FMT_STRING("{}{}"), ERROR_STR, error_code);',
              'fmt::format_to(it, fmt::runtime("{}{}"), ERROR_STR, error_code);')
        .gsub('fmt::format_to(out, FMT_STRING("{:x}"), value);',
              'fmt::format_to(out, fmt::runtime("{:x}"), value);')
        .gsub('fmt::format_to(out, FMT_STRING("{:08x}"), value);',
              'fmt::format_to(out, fmt::runtime("{:08x}"), value);')
        .gsub('fmt::format_to(out, FMT_STRING("p{}"),',
              'fmt::format_to(out, fmt::runtime("p{}"),')
      if patched != content
        File.write(fmt_inl, patched)
        puts "Patched #{fmt_inl} for Xcode 16 fmt consteval compatibility"
      end
    end

     # Force gRPC to generate module maps (FIX for missing gRPC-Core.modulemap)
    installer.pods_project.targets.each do |target|
      if target.name.include?('gRPC')
        target.build_configurations.each do |config|
          config.build_settings['DEFINES_MODULE'] = 'YES'
          config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
        end
      end
    end

    # Fix nanopb build: disable modules for nanopb (plain C) to avoid missing _Builtin_stdint.pcm on Xcode 16+
    installer.pods_project.targets.each do |target|
      if target.name == 'nanopb'
        target.build_configurations.each do |config|
          config.build_settings['CLANG_ENABLE_MODULES'] = 'NO'
        end
      end
    end
  end
end
