ENV['RCT_NEW_ARCH_ENABLED'] = '0'
# RN 0.83+ uses New Architecture by default — RCT_NEW_ARCH_ENABLED=0 is no longer supported.
# See: https://reactnative.dev/docs/new-architecture-intro

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

use_frameworks! :linkage => :static


target 'JICPrayerTimes' do
  config = use_native_modules!
  
  # 👇 gRPC pods MUST be inside the target
  pod 'gRPC-Core', :modular_headers => true
  pod 'gRPC-C++', :modular_headers => true
  # GoogleUtilities must be a module so Firebase can find it under use_frameworks! :static
  pod 'GoogleUtilities', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'widgetExtension' do
    inherit! :search_paths
    # Widget uses only WidgetKit + SwiftUI — no additional pods needed
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Ensure hermes-engine script phase has REACT_NATIVE_PATH (fixes: with-environment.sh: No such file or directory)
    react_native_path_value = File.join("${PODS_ROOT}", "..", config[:reactNativePath])
    installer.pods_project.targets.each do |target|
      if target.name == 'hermes-engine'
        target.build_configurations.each do |build_config|
          build_config.build_settings['REACT_NATIVE_PATH'] = react_native_path_value
        end
        break
      end
    end

    # Fix gRPC template syntax issue with Xcode 16.2+
    # The issue is in basic_seq.h where CallSeqFactory is used as a template member
    # This file exists in multiple locations (main pod dirs + Headers dirs)
    basic_seq_paths = [
      File.join(installer.sandbox.root, 'gRPC-Core/src/core/lib/promise/detail/basic_seq.h'),
      File.join(installer.sandbox.root, 'gRPC-C++/src/core/lib/promise/detail/basic_seq.h'),
      File.join(installer.sandbox.root, 'Headers/Private/gRPC-Core/grpc/src/core/lib/promise/detail/basic_seq.h'),
      File.join(installer.sandbox.root, 'Headers/Private/gRPC-C++/grpcpp/src/core/lib/promise/detail/basic_seq.h')
    ]
    
    basic_seq_paths.each do |file_path|
      if File.exist?(file_path)
        system("chmod +w '#{file_path}'")
        content = File.read(file_path)
        # Replace "Traits::template CallSeqFactory" with "Traits::CallSeqFactory"
        fixed_content = content.gsub(
          'Traits::template CallSeqFactory',
          'Traits::CallSeqFactory'
        )
        if content != fixed_content
          File.write(file_path, fixed_content)
          puts "Patched #{file_path}"
        end
      end
    end
    
    # Fix BoringSSL-GRPC build issue with unsupported -G flag on iOS simulator
    # The -GCC_WARN_INHIBIT_ALL_WARNINGS flag is being interpreted as -G by newer clang versions
    installer.pods_project.targets.each do |target|
      if target.name == 'BoringSSL-GRPC'
        target.source_build_phase.files.each do |file|
          if file.settings && file.settings['COMPILER_FLAGS']
            flags = file.settings['COMPILER_FLAGS'].split
            flags.reject! { |flag| flag == '-GCC_WARN_INHIBIT_ALL_WARNINGS' }
            file.settings['COMPILER_FLAGS'] = flags.join(' ')
          end
        end
      end
    end

    # Force gRPC to generate module maps (FIX for missing gRPC-Core.modulemap)
    installer.pods_project.targets.each do |target|
      if target.name.include?('gRPC')
        target.build_configurations.each do |config|
          config.build_settings['DEFINES_MODULE'] = 'YES'
          config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
        end
      end
    end

    # Fix nanopb build: disable modules for nanopb (plain C) to avoid missing _Builtin_stdint.pcm on Xcode 16+
    installer.pods_project.targets.each do |target|
      if target.name == 'nanopb'
        target.build_configurations.each do |config|
          config.build_settings['CLANG_ENABLE_MODULES'] = 'NO'
        end
      end
    end

    # FIX: Explicitly configure RCTSwiftUI to build as a proper Swift module.
    # Must run before the broad DEFINES_MODULE=NO sweep below.
    installer.pods_project.targets.each do |target|
      if target.name == 'RCTSwiftUI'
        target.build_configurations.each do |config|
          config.build_settings['DEFINES_MODULE'] = 'YES'
          config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
          config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'NO'
          config.build_settings['SWIFT_INSTALL_OBJC_HEADER'] = 'YES'
        end
      end
    end

    # FIX: RCTSwiftUIWrapper (ObjC) does @import RCTSwiftUI but CocoaPods doesn't
    # automatically add RCTSwiftUI.framework to its search paths in RN 0.83.
    # Manually inject $(BUILT_PRODUCTS_DIR) so the module can be resolved at compile time.
    installer.pods_project.targets.each do |target|
      if target.name == 'RCTSwiftUIWrapper'
        target.build_configurations.each do |config|
          existing = config.build_settings['FRAMEWORK_SEARCH_PATHS'] || ['$(inherited)']
          existing = [existing] if existing.is_a?(String)
          unless existing.include?('$(BUILT_PRODUCTS_DIR)')
            existing << '$(BUILT_PRODUCTS_DIR)'
          end
          config.build_settings['FRAMEWORK_SEARCH_PATHS'] = existing
        end
      end
    end

    # Fix non-modular-include-in-framework-module errors.
    # use_frameworks! :static makes every pod a framework module by default,
    # which breaks C/ObjC pods that include non-modular headers.
    #
    # We set DEFINES_MODULE=NO broadly to suppress non-modular-include errors,
    # but must exclude any pod that is itself imported as a module by another pod:
    #   - RCTSwiftUI / RCTSwiftUIWrapper  — imported by React Native
    #   - Firebase* / FirebaseCore*       — internal Firebase Swift modules
    #   - Google*                         — GoogleUtilities etc used by Firebase
    #   - gRPC*                           — already handled above, kept here for safety
    def self.needs_module?(name)
      name.include?('gRPC') ||
      name.start_with?('Firebase') ||
      name.start_with?('Google') ||
      name == 'RCTSwiftUI' ||
      name == 'RCTSwiftUIWrapper'
    end

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
        unless needs_module?(target.name)
          config.build_settings['DEFINES_MODULE'] = 'NO'
        end
      end
    end

    # Also fix generated projects (ReactCodegen, ReactAppDependencyProvider)
    installer.generated_projects.each do |project|
      project.targets.each do |target|
        target.build_configurations.each do |config|
          unless needs_module?(target.name)
            config.build_settings['DEFINES_MODULE'] = 'NO'
          end
        end
      end
    end

    # Fix widgetExtension deployment target — containerBackground & widget scene require iOS 17+
    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.user_project.native_targets.each do |target|
        if target.name == 'widgetExtension'
          target.build_configurations.each do |config|
            config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
          end
          puts "Set widgetExtension IPHONEOS_DEPLOYMENT_TARGET to 17.0"
        end
      end
    end

    # Fix [RNFB] Core Configuration build cycle AND non-modular-include errors on main app targets.
    # - CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES must also be set on user project
    #   targets (AppDelegate.mm, main.m, RNWidgetModule.m, etc.), not just pod targets.
    # - Clearing input_paths/output_paths on the RNFB script phase removes Xcode's dependency
    #   tracking that causes "Cycle inside IOMPrayerTimes".
    saved_projects = []
    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.user_project.native_targets.each do |target|

        # Fix non-modular-include errors on main app target files
        target.build_configurations.each do |config|
          config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
          config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
        end

        phase = target.build_phases.find do |p|
          p.respond_to?(:name) && p.name == '[CP-User] [RNFB] Core Configuration'
        end
        if phase
          phase.input_paths = []
          phase.output_paths = []
          target.build_phases.delete(phase)
          target.build_phases.push(phase)
          puts "Moved [RNFB] Core Configuration to end of #{target.name} build phases"
        end
      end

      # Save each user project only once (deduped to avoid redundant writes)
      unless saved_projects.include?(aggregate_target.user_project)
        aggregate_target.user_project.save
        saved_projects << aggregate_target.user_project
      end
    end
  end
end
